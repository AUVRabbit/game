; ============================================================
; 通天入地 (Tong Tian Ru Di)
; 四朋克混搭 · 2D 等距 ARPG · 开放世界 + 通天塔 + 沙盒建造
; ============================================================
; ⚠️  关于版本：Godot 官方不存在 2.7.4。
;     本配置兼容 Godot 3.5 LTS 与 Godot 4.x (gl_compatibility)
;     建议使用 Godot 4.2 LTS 或 Godot 3.5 LTS 打开。
; ============================================================

config_version=5

[application]

config/name="通天入地"
config/description="四朋克混搭世界 · 向上通天塔 · 向下深渊 · 等距 ARPG"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

; 多平台自适应
window/handheld/orientation=0

[input]

; ========== 移动（全平台映射）==========
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65,"key_label":0,"unicode":97,"echo":false,"script":null),
