; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="通天入地"
config/description="四朋克混搭世界 · 向上通天塔 · 向下深渊 · 等距 ARPG"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7.2", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

DataManager="*res://scripts/globals/data_manager.gd"
EventBus="*res://scripts/globals/event_bus.gd"
AudioManager="*res://scripts/globals/audio_manager.gd"
GameManager="*res://scripts/globals/game_manager.gd"
InputManager="*res://scripts/globals/input_manager.gd"
SaveManager="*res://scripts/globals/save_manager.gd"
BuildManager="*res://scripts/globals/build_manager.gd"
QuestManager="*res://scripts/globals/quest_manager.gd"
RoguelikeManager="*res://scripts/globals/roguelike_manager.gd"
ScreenShake="*res://scripts/combat/screen_shake.gd"
PunkManager="*res://scripts/globals/punk_manager.gd"
SkillManager="*res://scripts/globals/skill_manager.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/mode=2
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

