[layer_names]

2d_render/layer_1="地面 Tile"
2d_render/layer_2="装饰"
2d_render/layer_3="建筑"
2d_render/layer_4="角色"
2d_render/layer_5="特效"
2d_render/layer_6="UI"
2d_physics/layer_1="地面"
2d_physics/layer_2="角色"
2d_physics/layer_3="敌人"
2d_physics/layer_4="物品"
2d_physics/layer_5="机关"
2d_physics/layer_6="建筑"

[physics]

physics/common/physics_ticks_per_second=60
physics/2d/snap/snap_2d_transforms_to_pixel=true
physics/2d/snap/snap_2d_vertices_to_pixel=true
physics/2d/default_gravity=600.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.03, 0.05, 0.04, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[script]

script_class_name_enable_project_settings=true
